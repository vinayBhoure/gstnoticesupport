# =============================================================================
# gstnoticesupport.in — backend runtime environment (Docker / compose)
#
# Copy to `.env` at this repo root on the EC2 host and fill in real values.
# docker compose `env_file:` and `docker run --env-file` inject these into the
# app containers; the app validates them all at boot (server/src/lib/env.ts) and
# EXITS if any required one is missing.
#
# IMPORTANT — docker env-file format: KEY=VALUE only. No surrounding quotes, no
# spaces around `=`, no shell interpolation. A quoted value keeps its quotes.
#
# Never commit the real .env (git-ignored). Placeholders only in this file.
# IMAGE_TAG is NOT set here — deploy/deploy.sh exports it (the short git SHA).
# =============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── CORS / cookies ───────────────────────────────────────────────────────────
# Exact frontend origin, no trailing slash.
CLIENT_URL=https://gstnoticesupport.in
# Leading-dot domain so the auth cookie spans the api. subdomain. Optional.
COOKIE_DOMAIN=.gstnoticesupport.in

# ── Public API base URL (absolute links in emails) ───────────────────────────
API_URL=https://api.gstnoticesupport.in

# ── Database (Neon Postgres) ─────────────────────────────────────────────────
# Runtime uses the POOLED endpoint (host contains "-pooler"). Migrations may need
# the DIRECT endpoint if the pooler throws prepared-statement errors.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require&connection_limit=5&pool_timeout=10

# ── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-different-long-random-secret

# ── Admin identity + notification recipient ──────────────────────────────────
ADMIN_EMAIL=admin@gstnoticesupport.in
# Where admin notification emails are delivered. Optional — falls back to ADMIN_EMAIL.
ADMIN_NOTIFICATION_EMAIL=your-admin-inbox@example.com

# ── AWS S3 (private document bucket) ─────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=gstnoticesupport-docs
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ── Resend (transactional email) ─────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=support@gstnoticesupport.in

# ── Razorpay (payments) — rzp_live_ in production only ────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ── Seed-only (not read by the env validation module) ────────────────────────
# Needed only if you run `prisma db seed` to create the admin login; the deploy
# pipeline runs migrations, not the seed.
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-me-before-seeding
