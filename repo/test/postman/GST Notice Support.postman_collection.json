    {
      "name": "Upload URL — success (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "const res = pm.response.json().data;",
              "pm.test('uploadUrl is a signed https url', function () { pm.expect(res.uploadUrl).to.be.a('string'); pm.expect(res.uploadUrl).to.match(/^https:\\/\\//); pm.expect(res.uploadUrl).to.include('X-Amz-Signature'); });",
              "pm.test('s3Key ends with .pdf', function () { pm.expect(res.s3Key).to.match(/\\.pdf$/); });",
              "pm.test('s3Key is scoped to this booking', function () { pm.expect(res.s3Key).to.include('/' + pm.environment.get('bookingId') + '/'); });",
              "pm.test('s3Key stem is sanitized (no spaces or bang)', function () { pm.expect(res.s3Key).to.not.match(/[ !]/); });",
              "pm.test('expiresAt present', function () { pm.expect(res.expiresAt).to.be.a('string'); });",
              "pm.environment.set('docS3Key', res.s3Key);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"fileName\": \"gst notice jan 2024!.pdf\",\n  \"fileSize\": 1048576,\n  \"contentType\": \"application/pdf\"\n}" },
        "url": { "raw": "{{baseUrl}}/bookings/{{bookingId}}/upload-url", "host": ["{{baseUrl}}"], "path": ["bookings", "{{bookingId}}", "upload-url"] }
