              "const doc = pm.response.json().data.document;",
              "pm.test('document belongs to booking', function () { pm.expect(doc.bookingId).to.eql(pm.environment.get('bookingId')); });",
              "pm.test('uploadedBy = user', function () { pm.expect(doc.uploadedBy).to.eql('user'); });",
              "pm.test('original fileName preserved', function () { pm.expect(doc.fileName).to.eql('gst notice jan 2024!.pdf'); });",
              "pm.test('s3Key never returned', function () { pm.expect(doc).to.not.have.property('s3Key'); });"
            ]
          }
        }
      ],
