{
  "info": {
    "name": "GST Notice Support — Final Draft",
    "description": "Post-payment final-draft feature (feature/phase-2/final-draft). Admin uploads a final draft once a booking is in filing/complete; the user reads it via GET /bookings/:id/draft-url?variant=. Fixtures (draft_ready/filing/complete bookings owned by the seeded admin, each with a placeholder original draftS3Key) are minted by server/scripts/setup-final-draft-fixtures.mjs and injected as a single JSON env-var (finalDraftFixturesJson), parsed in the collection pre-request. draft-confirm/draft-url only check the S3 KEY (prefix + which key), never object existence, and the pre-signed GET URL embeds the key path — so the suite asserts drafts/ vs final-drafts/ in the returned URL. Deferred to Layer 3 (browser MCP): the real S3 PUT/GET and the real Razorpay capture that produces filing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('_fixturesLoaded')) {",
          "  const raw = pm.environment.get('finalDraftFixturesJson');",
          "  if (raw) {",
          "    try {",
          "      const f = JSON.parse(raw);",
          "      Object.keys(f).forEach(function (k) { pm.environment.set(k, f[k]); });",
          "      pm.environment.set('_fixturesLoaded', '1');",
          "    } catch (e) { console.log('fixture parse failed', e); }",
          "  }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Unauthenticated (401)",
      "item": [
        {
          "name": "final-draft-upload-url — no auth (401)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 401', function () { pm.response.to.have.status(401); });",
            "pm.test('code UNAUTHORIZED', function () { pm.expect(pm.response.json().error.code).to.eql('UNAUTHORIZED'); });"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fileName\": \"final.pdf\",\n  \"fileSize\": 1048576,\n  \"contentType\": \"application/pdf\"\n}" }, "url": { "raw": "{{baseUrl}}/admin/bookings/{{filingId}}/final-draft-upload-url", "host": ["{{baseUrl}}"], "path": ["admin", "bookings", "{{filingId}}", "final-draft-upload-url"] } }
        },
        {
          "name": "final-draft-confirm — no auth (401)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 401', function () { pm.response.to.have.status(401); });"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"s3Key\": \"final-drafts/x-1.pdf\",\n  \"fileName\": \"final.pdf\"\n}" }, "url": { "raw": "{{baseUrl}}/admin/bookings/{{filingId}}/final-draft-confirm", "host": ["{{baseUrl}}"], "path": ["admin", "bookings", "{{filingId}}", "final-draft-confirm"] } }
        }
      ]
    },
