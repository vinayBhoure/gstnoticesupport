            "pm.test('success true', function () { pm.expect(b.success).to.eql(true); });",
            "pm.test('data is array', function () { pm.expect(b.data).to.be.an('array'); });",
            "pm.test('meta has page/limit/total numbers', function () { pm.expect(b.meta.page).to.be.a('number'); pm.expect(b.meta.limit).to.be.a('number'); pm.expect(b.meta.total).to.be.a('number'); });",
            "pm.test('items carry user + no PII contact fields', function () { if (b.data.length) { const it = b.data[0]; pm.expect(it.user).to.be.an('object'); pm.expect(it.user).to.have.property('email'); pm.expect(it).to.not.have.property('gstn'); pm.expect(it).to.not.have.property('contactEmail'); } });"
          ] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/admin/bookings", "host": ["{{baseUrl}}"], "path": ["admin", "bookings"] } }
        },
