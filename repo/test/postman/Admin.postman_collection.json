{
  "info": {
    "name": "GST Notice Support — Admin Surface",
    "description": "Phase 6 (EP13) admin endpoints under /api/v1/admin. Auth: seeded admin login for functional tests; a verified role=user account for RBAC 403 checks (both injected at runtime via --env-var). Fixtures (one test user + eight bookings pinned to specific states) are minted by server/scripts/setup-admin-fixtures.mjs and injected as a single JSON env-var (adminFixturesJson), parsed in the collection pre-request. Deferred (need a real captured Razorpay test payment, like EP12/D77): mark-paid 200 success, 422 PAYMENT_NOT_CAPTURED, cross-booking guard, and the real browser->S3 PUT — see ADMIN_TEST_PLAN.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('_fixturesLoaded')) {",
          "  const raw = pm.environment.get('adminFixturesJson');",
          "  if (raw) {",
          "    try {",
          "      const f = JSON.parse(raw);",
          "      Object.keys(f).forEach(function (k) { pm.environment.set(k, f[k]); });",
          "      pm.environment.set('_fixturesLoaded', '1');",
          "    } catch (e) { console.log('fixture parse failed', e); }",
          "  }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Unauthenticated (401)",
      "item": [
        {
          "name": "List bookings — no auth (401)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 401', function () { pm.response.to.have.status(401); });",
            "pm.test('code UNAUTHORIZED', function () { pm.expect(pm.response.json().error.code).to.eql('UNAUTHORIZED'); });"
          ] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/admin/bookings", "host": ["{{baseUrl}}"], "path": ["admin", "bookings"] } }
        },
        {
          "name": "Mark-paid — no auth (401)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 401', function () { pm.response.to.have.status(401); });",
            "pm.test('code UNAUTHORIZED', function () { pm.expect(pm.response.json().error.code).to.eql('UNAUTHORIZED'); });"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"razorpayPaymentId\": \"pay_x\"\n}" }, "url": { "raw": "{{baseUrl}}/admin/bookings/{{draftReadyId}}/mark-paid", "host": ["{{baseUrl}}"], "path": ["admin", "bookings", "{{draftReadyId}}", "mark-paid"] } }
        },
        {
          "name": "Stats — no auth (401)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 401', function () { pm.response.to.have.status(401); });"
          ] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/admin/stats", "host": ["{{baseUrl}}"], "path": ["admin", "stats"] } }
        }
      ]
    },
    {
      "name": "2. Login as regular user",
