            "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
            "const d = pm.response.json().data.booking;",
            "pm.test('has user object', function () { pm.expect(d.user).to.be.an('object'); pm.expect(d.user).to.have.property('name'); });",
            "pm.test('documents is array', function () { pm.expect(d.documents).to.be.an('array'); });",
            "pm.test('paymentRecords is array (all attempts)', function () { pm.expect(d.paymentRecords).to.be.an('array'); });",
            "pm.test('hasDraft is boolean', function () { pm.expect(d.hasDraft).to.be.a('boolean'); });",
            "pm.test('draftS3Key never exposed', function () { pm.expect(d).to.not.have.property('draftS3Key'); });",
            "pm.test('document s3Key never exposed', function () { d.documents.forEach(function (x) { pm.expect(x).to.not.have.property('s3Key'); }); });"
          ] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/admin/bookings/{{draftReadyId}}", "host": ["{{baseUrl}}"], "path": ["admin", "bookings", "{{draftReadyId}}"] } }
