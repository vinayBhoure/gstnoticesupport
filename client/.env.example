# EmailJS — Contact Form (Phase 1)
# All three values are required. Get them from https://www.emailjs.com/
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Calendly — Request Callback popup (Phase 1)
# Full scheduling link, e.g. https://calendly.com/your-account/your-event
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-account/your-event
