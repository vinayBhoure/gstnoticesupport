# Resend — Contact Form email (Phase 1, server-side only)
# Used by the /api/contact Next.js Route Handler. NEVER prefix with NEXT_PUBLIC_.
RESEND_API_KEY=re_your_api_key
# Sender must be on a Resend-verified domain (or onboarding@resend.dev for testing)
CONTACT_FROM_EMAIL=support@gstnoticesupport.in
# Where contact enquiries are delivered
CONTACT_TO_EMAIL=bhoure05@gmail.com

# Calendly — Request Callback popup (Phase 1, client-side)
# Full scheduling link, e.g. https://calendly.com/your-account/your-event
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-account/your-event

# Canonical site URL — drives metadataBase, sitemap, robots, OG/canonical URLs
NEXT_PUBLIC_SITE_URL=https://gstnoticesupport.in

# Organization identity (server-side — drives JSON-LD, Footer, legal pages)
ORG_LEGAL_NAME=GST Notice Support Pvt. Ltd.
ORG_PHONE=+919343297622
ORG_EMAIL=support@gstnoticesupport.in
ORG_GRIEVANCE_OFFICER=Customer Support
ORG_ADDRESS_STREET=Dashmesh Dear, The brain train academy, opp. Gurudwara, Premnagar, Madan Mahal
ORG_ADDRESS_LOCALITY=Jabalpur
ORG_ADDRESS_REGION=Madhya Pradesh
ORG_ADDRESS_POSTAL=482001
ORG_ADDRESS_COUNTRY=IN
