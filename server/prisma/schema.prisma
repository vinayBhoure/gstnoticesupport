// =============================================================================
// gstnoticesupport.in — Prisma schema
// Source of truth: docs/architecture/schema.prisma
// Database: PostgreSQL (NeonDB, Mumbai region)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  user
  admin

  @@map("user_role_enum")
}

// Scopes an OTP to the flow that issued it, so a password-reset code can never be
// replayed against /auth/verify-otp and the two flows do not evict each other's code.
enum OtpPurpose {
  email_verification
  password_reset

  @@map("otp_purpose_enum")
}

enum ServiceType {
  asmt_10
  scn
  commissioner_appeal
  gstat_appeal
  representation

  @@map("service_enum")
}

enum BookingStatus {
  document_upload
  in_review
  draft_ready
  filing
  complete
  cancelled

  @@map("booking_status_enum")
}

enum PaymentStatus {
  pending
  paid
  failed

  @@map("payment_status_enum")
}

enum FilingFor {
  self
  others

  @@map("filing_enum")
}

enum UploadedBy {
  user
  admin

  @@map("upload_by_enum")
}

enum PaymentRecordStatus {
  created
  authorized
  captured
  failed

  @@map("pay_rec_status_enum")
}

// D66 (2026-06-16) — records how a payment was captured for admin audit
enum PaymentSource {
  webhook
  verify
  admin_override

  @@map("payment_source_enum")
}

// =============================================================================
// CORE MODELS (locked 4-table structure per LLD)
// =============================================================================

model User {
  id                 String        @id @default(uuid()) @db.Uuid
  name               String        @db.VarChar(255)
  email              String        @unique @db.VarChar(255)
  hashedPassword     String        @map("hashed_password") @db.VarChar(255)
  // Collected at complete-profile (D67); nullable until then.
  phone              String?       @db.VarChar(20)
  role               UserRole      @default(user)
  emailVerified      Boolean       @default(false) @map("email_verified")
  termsAccepted      Boolean       @default(false) @map("terms_accepted")
  allowPromotions    Boolean       @default(false) @map("allow_promotions")
  interestedServices ServiceType[] @default([]) @map("interested_services")
  // Access tokens issued before this instant are rejected by authenticate.ts. Stamped on
  // password reset/change so every other device loses its session immediately, instead of
  // surviving until its 12h access token expires (revoking refresh tokens alone is not enough).
  sessionsValidFrom  DateTime?     @map("sessions_valid_from") @db.Timestamptz(6)
  // database.md §3 — users are soft-deleted; never call prisma.user.delete()
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  bookings       Booking[]
  otpEntries     OtpStore[]
  refreshTokens  RefreshToken[]
  adminOverrides PaymentRecord[] @relation("AdminPaymentOverrides")

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model Booking {
  id                         String        @id @default(uuid()) @db.Uuid
  userId                     String        @map("user_id") @db.Uuid
  serviceType                ServiceType   @map("service_type")
  status                     BookingStatus @default(document_upload)
  paymentStatus              PaymentStatus @default(pending) @map("payment_status")
  contactName                String        @map("contact_name") @db.VarChar(255)
  contactEmail               String        @map("contact_email") @db.VarChar(255)
  contactPhone               String        @map("contact_phone") @db.VarChar(20)
  organizationName           String?       @map("organization_name") @db.VarChar(255)
  filingFor                  FilingFor     @map("filing_for")
  gstn                       String?       @db.VarChar(15)
  consentInformationAccurate Boolean       @map("consent_information_accurate")
  consentContactAuthorized   Boolean       @map("consent_contact_authorized")
  draftS3Key                 String?       @map("draft_s3_key") @db.Text
  finalDraftS3Key            String?       @map("final_draft_s3_key") @db.Text
  // Per-booking custom fee (paise) for consultation-priced services (representation).
  // Set by the admin at draft-confirm; the Razorpay order uses it instead of a fixed price.
  quotedAmountPaise          Int?          @map("quoted_amount_paise")
  adminNote                  String?       @map("admin_note") @db.Text
  createdAt                  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // onDelete: Restrict — account deletion blocked while any booking is active (database.md §3.3)
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  documents      BookingDocument[]
  paymentRecords PaymentRecord[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([userId, status])
  @@map("bookings")
}

model BookingDocument {
  id         String     @id @default(uuid()) @db.Uuid
  bookingId  String     @map("booking_id") @db.Uuid
  uploadedBy UploadedBy @map("uploaded_by")
  fileName   String     @map("file_name") @db.VarChar(255)
  // S3 key format: {userId}/{bookingId}/{yyyyMMdd}-{sanitizedName}-{4rand}.pdf (backend.md §9.3)
  s3Key      String     @unique @map("s3_key") @db.VarChar(512)
  uploadedAt DateTime   @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  // No user_id FK — documents inherit ownership via booking → user (database.md §7.1)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_documents")
}

model PaymentRecord {
  id                String              @id @default(uuid()) @db.Uuid
  // NOT unique on booking_id — multiple attempt rows per booking are expected (LLD Decision 62)
  bookingId         String              @map("booking_id") @db.Uuid
  razorpayOrderId   String              @unique @map("razorpay_order_id") @db.VarChar(255)
  // Nullable until captured. UNIQUE is the sole payment idempotency source (backend_plan.md §locked-invariants)
  razorpayPaymentId String?             @unique @map("razorpay_payment_id") @db.VarChar(255)
  amountPaise       Int                 @map("amount_paise")
  currency          String              @default("INR") @db.VarChar(3)
  status            PaymentRecordStatus @default(created)
  // D66 — audit trail: how was this payment captured, and by which admin (if override)?
  source            PaymentSource       @default(webhook)
  performedByAdminId String?            @map("performed_by_admin_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking          Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // onDelete: SetNull — admin deletion nulls the audit ref rather than blocking or cascading
  performedByAdmin User?   @relation("AdminPaymentOverrides", fields: [performedByAdminId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
  @@map("payment_records")
}

// =============================================================================
// AUXILIARY MODELS — auth + token lifecycle
// Rate-limit counters intentionally omitted: in-memory express-rate-limit (LLD §9 Q1 resolved)
// =============================================================================

model OtpStore {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  purpose      OtpPurpose @default(email_verification)
  hashedOtp    String     @map("hashed_otp") @db.VarChar(255)
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(6)
  // Capped at 5 attempts per LLD §6 rate-limit matrix
  attemptCount Int        @default(0) @map("attempt_count") @db.SmallInt
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("otp_store")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // Hash of the token only — raw token never stored (backend_plan.md §locked-invariants)
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  // 7-day expiry per backend_plan.md §locked-invariants
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model TokenBlacklist {
  id        String   @id @default(uuid()) @db.Uuid
  // Logout + "This wasn't me" only — scope is locked (backend_plan.md §locked-invariants)
  tokenJti  String   @unique @map("token_jti") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // No FK — tracks tokens, not users. JTI is globally unique by design.

  @@index([expiresAt])
  @@map("token_blacklist")
}
