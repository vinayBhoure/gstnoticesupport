# =============================================================================
# gstnoticesupport.in — Server Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend origin. Must be exact (no trailing slash).
CLIENT_URL=http://localhost:3000

# ── Database (Phase 1) ────────────────────────────────────────────────────────
# NeonDB connection string — dev branch.
# Format: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ── Admin Seed (Phase 1 — seed script only, not loaded at app boot) ───────────
ADMIN_EMAIL=admin@gstnoticesupport.in
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-me-before-seeding

# ── Auth / JWT (Phase 2) ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-different-long-random-secret

# ── AWS S3 (Phase 4) ──────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=gstnoticesupport-docs

# ── Resend (Phase 2) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=support@gstnoticesupport.in

# ── Razorpay (Phase 5) ────────────────────────────────────────────────────────
# Use rzp_test_ prefix for development; rzp_live_ for production only.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
