# =============================================================================
# gstnoticesupport.in — Server Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend origin. Must be exact (no trailing slash).
CLIENT_URL=http://localhost:3000
COOKIE_DOMAIN=.abc.in

# ── Public API base URL ───────────────────────────────────────────────────────
# Used to build absolute links in emails (e.g. the login "This wasn't me" link).
# Dev: http://localhost:4000 · Prod: https://api.gstnoticesupport.in
API_URL=http://localhost:4000

# ── Database (Phase 1) ────────────────────────────────────────────────────────
# NeonDB connection string — dev branch.
# Format: postgresql://user:pass@host/dbname?sslmode=require
#
# Runtime app MUST use Neon's POOLED endpoint (host contains "-pooler") so the
# persistent Node process doesn't exhaust Neon's connection ceiling under load.
# Tune the Prisma pool with connection_limit (small on a shared Hostinger box) and
# pool_timeout; apply the same params to the Hostinger backend env and restart (D95).
#   ...neon.tech/db?sslmode=require&connection_limit=5&pool_timeout=10
# Note: `prisma migrate` prefers the DIRECT (non-pooler) host — use that endpoint
# for migrations if you hit prepared-statement errors through the pooler.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require&connection_limit=5&pool_timeout=10

# ── Admin (account identity for seed/login) ───────────────────────────────────
# ADMIN_EMAIL is the admin account's login identity — used by the seed to create the
# admin user and looked up by admin tooling/fixtures. Keep it stable and branded.
# ADMIN_NAME / ADMIN_PASSWORD are seed-only.
ADMIN_EMAIL=admin@gstnoticesupport.in
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-me-before-seeding

# ── Admin notification recipient (delivery) ───────────────────────────────────
# Where admin NOTIFICATION emails are delivered. Optional — falls back to ADMIN_EMAIL
# when unset. Set it to an external mailbox you actually read (e.g. a Gmail address):
# until the sending domain's SPF/DKIM/DMARC are verified in Resend, mail to an address
# on the SAME domain as RESEND_FROM_EMAIL may silently vanish — which is why admin
# notifications to admin@<same-domain> can go missing.
ADMIN_NOTIFICATION_EMAIL=your-admin-inbox@example.com

# ── Auth / JWT (Phase 2) ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-different-long-random-secret
# Cookie domain — leave UNSET in development (so cookies work on localhost).
# Prod/staging: .gstnoticesupport.in (leading dot lets it span api. subdomain).
# COOKIE_DOMAIN=.gstnoticesupport.in

# ── AWS S3 (Phase 4) ──────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=gstnoticesupport-docs

# ── Resend (Phase 2) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=support@gstnoticesupport.in

# ── Razorpay (Phase 5) ────────────────────────────────────────────────────────
# Use rzp_test_ prefix for development; rzp_live_ for production only.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
