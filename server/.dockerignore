# Dependencies + build output — rebuilt inside the image
node_modules
dist

# Secrets — never enter the build context or the image
.env
.env.*
!.env.example

# Local/editor/VCS noise
.git
.gitignore
*.log
npm-debug.log*

# Not needed at runtime (seed uses tsx; migrations applied out of band)
scripts

# Docker files themselves
Dockerfile
.dockerignore
