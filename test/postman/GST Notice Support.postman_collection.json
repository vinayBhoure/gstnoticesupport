{
  "info": {
    "name": "GST Notice Support",
    "description": "Automated API tests for gstnoticesupport.in. Scope: Phase 3 Booking Lifecycle (4 endpoints) plus the admin login required to reach them. Auth strategy: log in as the seeded admin (credentials injected at runtime via --env-var; never stored in this file). OTP success-path and cancel success-path (which need draft_ready) are out of scope until Phases 4-6 land.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth gate — Create booking unauthenticated (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Runs first, before login — the cookie jar is empty, so authenticate must reject.",
              "pm.test('status is 401', function () { pm.response.to.have.status(401); });",
              "const body = pm.response.json();",
              "pm.test('envelope success=false', function () { pm.expect(body.success).to.eql(false); });",
              "pm.test('error code UNAUTHORIZED', function () { pm.expect(body.error.code).to.eql('UNAUTHORIZED'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"serviceType\": \"asmt_10\",\n  \"contactName\": \"Ravi Kumar\",\n  \"contactEmail\": \"ravi@example.com\",\n  \"contactPhone\": \"+919876543210\",\n  \"organizationName\": \"Ravi Enterprises\",\n  \"filingFor\": \"self\",\n  \"gstn\": \"29AABCU9603R1ZX\",\n  \"consentInformationAccurate\": true,\n  \"consentContactAuthorized\": true\n}"
        },
        "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] }
      }
    },
    {
      "name": "Login (admin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('envelope success=true', function () { pm.expect(body.success).to.eql(true); });",
              "pm.test('returns user', function () { pm.expect(body.data.user).to.be.an('object'); });",
              "const cookies = pm.response.headers.all().filter(function (h) { return h.key.toLowerCase() === 'set-cookie'; });",
              "pm.test('access_token cookie set', function () {",
              "  pm.expect(cookies.some(function (c) { return c.value.startsWith('access_token='); })).to.be.true;",
              "});",
              "pm.test('refresh_token cookie set', function () {",
              "  pm.expect(cookies.some(function (c) { return c.value.startsWith('refresh_token='); })).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
      }
    },
    {
      "name": "Create booking — invalid GSTN (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', function () { pm.response.to.have.status(400); });",
              "const body = pm.response.json();",
              "pm.test('error code VALIDATION_ERROR', function () { pm.expect(body.error.code).to.eql('VALIDATION_ERROR'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"serviceType\": \"asmt_10\",\n  \"contactName\": \"Ravi Kumar\",\n  \"contactEmail\": \"ravi@example.com\",\n  \"contactPhone\": \"+919876543210\",\n  \"filingFor\": \"self\",\n  \"gstn\": \"AAAAAAAAAAAAAAA\",\n  \"consentInformationAccurate\": true,\n  \"consentContactAuthorized\": true\n}"
        },
        "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] }
      }
    },
    {
      "name": "Create booking — consent not accepted (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', function () { pm.response.to.have.status(400); });",
              "const body = pm.response.json();",
              "pm.test('error code VALIDATION_ERROR', function () { pm.expect(body.error.code).to.eql('VALIDATION_ERROR'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"serviceType\": \"asmt_10\",\n  \"contactName\": \"Ravi Kumar\",\n  \"contactEmail\": \"ravi@example.com\",\n  \"contactPhone\": \"+919876543210\",\n  \"filingFor\": \"self\",\n  \"gstn\": \"29AABCU9603R1ZX\",\n  \"consentInformationAccurate\": false,\n  \"consentContactAuthorized\": true\n}"
        },
        "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] }
      }
    },
    {
      "name": "Create booking — success (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test('envelope success=true', function () { pm.expect(body.success).to.eql(true); });",
              "pm.test('message matches contract', function () { pm.expect(body.message).to.eql('Booking created. Please upload your documents to proceed.'); });",
              "const booking = body.data.booking;",
              "pm.test('status = document_upload', function () { pm.expect(booking.status).to.eql('document_upload'); });",
              "pm.test('paymentStatus = pending', function () { pm.expect(booking.paymentStatus).to.eql('pending'); });",
              "pm.test('client-supplied price is stripped', function () { pm.expect(booking).to.not.have.property('amountPaise'); });",
              "pm.test('draftS3Key never returned', function () { pm.expect(booking).to.not.have.property('draftS3Key'); });",
              "pm.test('gstn echoed', function () { pm.expect(booking.gstn).to.eql('29AABCU9603R1ZX'); });",
              "pm.environment.set('bookingId', booking.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"serviceType\": \"asmt_10\",\n  \"contactName\": \"Ravi Kumar\",\n  \"contactEmail\": \"ravi@example.com\",\n  \"contactPhone\": \"+919876543210\",\n  \"organizationName\": \"Ravi Enterprises\",\n  \"filingFor\": \"self\",\n  \"gstn\": \"29AABCU9603R1ZX\",\n  \"consentInformationAccurate\": true,\n  \"consentContactAuthorized\": true,\n  \"amountPaise\": 1\n}"
        },
        "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] }
      }
    },
    {
      "name": "List bookings (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('data is an array', function () { pm.expect(body.data).to.be.an('array'); });",
              "pm.test('contains created booking, newest first', function () {",
              "  pm.expect(body.data.length).to.be.above(0);",
              "  pm.expect(body.data[0].id).to.eql(pm.environment.get('bookingId'));",
              "});",
              "pm.test('summary shape (no contactName)', function () { pm.expect(body.data[0]).to.not.have.property('contactName'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] }
      }
    },
    {
      "name": "Get booking detail (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "const booking = pm.response.json().data.booking;",
              "pm.test('id matches', function () { pm.expect(booking.id).to.eql(pm.environment.get('bookingId')); });",
              "pm.test('has documents array', function () { pm.expect(booking.documents).to.be.an('array'); });",
              "pm.test('has latestPayment key', function () { pm.expect(booking).to.have.property('latestPayment'); });",
              "pm.test('detail shape includes gstn', function () { pm.expect(booking.gstn).to.eql('29AABCU9603R1ZX'); });",
              "pm.test('draftS3Key never returned', function () { pm.expect(booking).to.not.have.property('draftS3Key'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["bookings", "{{bookingId}}"] }
      }
    },
