              "pm.test('envelope success=true', function () { pm.expect(body.success).to.eql(true); });",
              "pm.test('amountPaise is server-derived 299900', function () { pm.expect(body.data.amountPaise).to.eql(299900); });",
              "pm.test('currency INR', function () { pm.expect(body.data.currency).to.eql('INR'); });",
              "pm.test('orderId present', function () { pm.expect(body.data.orderId).to.be.a('string').and.match(/^order_/); });",
              "pm.test('keyId is test key', function () { pm.expect(body.data.keyId).to.match(/^rzp_test_/); });",
              "pm.test('prefill present', function () { pm.expect(body.data.prefill).to.be.an('object'); });",
              "pm.environment.set('capturedOrderId', body.data.orderId);"
            ]
          }
