{
  "info": {
    "name": "GST Notice Support — Representation Service",
    "description": "Representation Before Authority as a bookable, custom-priced service (feature/phase-2/representation-service). Self-contained: the seeded admin logs in, creates its own representation + asmt_10 bookings via the API, and drives them forward. Verifies: the new enum value is bookable, draft-confirm requires a quote (₹500–₹1,00,000) for representation and rejects it for other services, and the Razorpay order amount equals the per-booking quote. Real Razorpay capture at the quoted amount is deferred to Layer 3 (browser MCP).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login as admin",
      "item": [
        {
          "name": "Login (admin)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
            "const cookies = pm.response.headers.all().filter(function (h) { return h.key.toLowerCase() === 'set-cookie'; });",
            "pm.test('access_token cookie set', function () { pm.expect(cookies.some(function (c) { return c.value.startsWith('access_token='); })).to.be.true; });"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }, "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] } }
        }
      ]
    },
    {
      "name": "2. Create representation booking",
      "item": [
        {
          "name": "POST /bookings serviceType=representation (201)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
            "const b = pm.response.json().data.booking;",
            "pm.environment.set('repBookingId', b.id);",
            "pm.test('serviceType representation', function () { pm.expect(b.serviceType).to.eql('representation'); });",
            "pm.test('starts in document_upload', function () { pm.expect(b.status).to.eql('document_upload'); });",
            "pm.test('quotedAmountPaise null initially', function () { pm.expect(b.quotedAmountPaise).to.eql(null); });"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"serviceType\": \"representation\",\n  \"contactName\": \"Representation Test\",\n  \"contactEmail\": \"representation-test@example.com\",\n  \"contactPhone\": \"+919876500000\",\n  \"organizationName\": \"__TEST__ representation\",\n  \"filingFor\": \"self\",\n  \"gstn\": \"29AABCU9603R1ZX\",\n  \"consentInformationAccurate\": true,\n  \"consentContactAuthorized\": true\n}" }, "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] } }
        }
      ]
    },
    {
      "name": "3. Quote gating at draft-confirm",
      "item": [
        {
          "name": "admin -> in_review (200)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
            "pm.test('now in_review', function () { pm.expect(pm.response.json().data.booking.status).to.eql('in_review'); });"
          ] } }],
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"in_review\"\n}" }, "url": { "raw": "{{baseUrl}}/admin/bookings/{{repBookingId}}/status", "host": ["{{baseUrl}}"], "path": ["admin", "bookings", "{{repBookingId}}", "status"] } }
        },
        {
          "name": "draft-confirm WITHOUT quote (400 QUOTE_REQUIRED)",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [ "pm.environment.set('repDraftKey', 'drafts/' + pm.environment.get('repBookingId') + '-20260101-draft-ab12.pdf');" ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('status is 400', function () { pm.response.to.have.status(400); });",
              "pm.test('code QUOTE_REQUIRED', function () { pm.expect(pm.response.json().error.code).to.eql('QUOTE_REQUIRED'); });"
            ] } }
          ],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"s3Key\": \"{{repDraftKey}}\",\n  \"fileName\": \"draft.pdf\"\n}" }, "url": { "raw": "{{baseUrl}}/admin/bookings/{{repBookingId}}/draft-confirm", "host": ["{{baseUrl}}"], "path": ["admin", "bookings", "{{repBookingId}}", "draft-confirm"] } }
        },
        {
          "name": "draft-confirm quote below min (400 VALIDATION_ERROR)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 400', function () { pm.response.to.have.status(400); });",
            "pm.test('code VALIDATION_ERROR', function () { pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'); });"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"s3Key\": \"{{repDraftKey}}\",\n  \"fileName\": \"draft.pdf\",\n  \"quotedAmountPaise\": 40000\n}" }, "url": { "raw": "{{baseUrl}}/admin/bookings/{{repBookingId}}/draft-confirm", "host": ["{{baseUrl}}"], "path": ["admin", "bookings", "{{repBookingId}}", "draft-confirm"] } }
        },
        {
          "name": "draft-confirm quote above max (400 VALIDATION_ERROR)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 400', function () { pm.response.to.have.status(400); });",
            "pm.test('code VALIDATION_ERROR', function () { pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'); });"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"s3Key\": \"{{repDraftKey}}\",\n  \"fileName\": \"draft.pdf\",\n  \"quotedAmountPaise\": 10000001\n}" }, "url": { "raw": "{{baseUrl}}/admin/bookings/{{repBookingId}}/draft-confirm", "host": ["{{baseUrl}}"], "path": ["admin", "bookings", "{{repBookingId}}", "draft-confirm"] } }
        },
        {
          "name": "draft-confirm quote=750000 (200 -> draft_ready)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
            "const b = pm.response.json().data.booking;",
            "pm.test('now draft_ready', function () { pm.expect(b.status).to.eql('draft_ready'); });",
            "pm.test('quotedAmountPaise stored = 750000', function () { pm.expect(b.quotedAmountPaise).to.eql(750000); });",
            "pm.test('hasDraft true', function () { pm.expect(b.hasDraft).to.eql(true); });"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"s3Key\": \"{{repDraftKey}}\",\n  \"fileName\": \"draft.pdf\",\n  \"quotedAmountPaise\": 750000\n}" }, "url": { "raw": "{{baseUrl}}/admin/bookings/{{repBookingId}}/draft-confirm", "host": ["{{baseUrl}}"], "path": ["admin", "bookings", "{{repBookingId}}", "draft-confirm"] } }
        },
        {
          "name": "detail reflects quotedAmountPaise (200)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
            "pm.test('quotedAmountPaise = 750000', function () { pm.expect(pm.response.json().data.booking.quotedAmountPaise).to.eql(750000); });"
          ] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/admin/bookings/{{repBookingId}}", "host": ["{{baseUrl}}"], "path": ["admin", "bookings", "{{repBookingId}}"] } }
        }
      ]
    },
    {
      "name": "4. Non-representation rejects a quote",
      "item": [
        {
          "name": "POST /bookings serviceType=asmt_10 (201)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
            "pm.environment.set('asmtBookingId', pm.response.json().data.booking.id);"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"serviceType\": \"asmt_10\",\n  \"contactName\": \"Asmt Test\",\n  \"contactEmail\": \"asmt-test@example.com\",\n  \"contactPhone\": \"+919876500000\",\n  \"organizationName\": \"__TEST__ representation\",\n  \"filingFor\": \"self\",\n  \"gstn\": \"29AABCU9603R1ZX\",\n  \"consentInformationAccurate\": true,\n  \"consentContactAuthorized\": true\n}" }, "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] } }
        },
        {
          "name": "admin -> in_review (200)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
          ] } }],
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"in_review\"\n}" }, "url": { "raw": "{{baseUrl}}/admin/bookings/{{asmtBookingId}}/status", "host": ["{{baseUrl}}"], "path": ["admin", "bookings", "{{asmtBookingId}}", "status"] } }
        },
        {
          "name": "draft-confirm with quote on asmt_10 (400 VALIDATION_ERROR)",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [ "pm.environment.set('asmtDraftKey', 'drafts/' + pm.environment.get('asmtBookingId') + '-20260101-draft-cd34.pdf');" ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('status is 400', function () { pm.response.to.have.status(400); });",
              "pm.test('code VALIDATION_ERROR', function () { pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'); });"
            ] } }
          ],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"s3Key\": \"{{asmtDraftKey}}\",\n  \"fileName\": \"draft.pdf\",\n  \"quotedAmountPaise\": 750000\n}" }, "url": { "raw": "{{baseUrl}}/admin/bookings/{{asmtBookingId}}/draft-confirm", "host": ["{{baseUrl}}"], "path": ["admin", "bookings", "{{asmtBookingId}}", "draft-confirm"] } }
        }
      ]
    },
    {
      "name": "5. Payment initiate uses the quote",
      "item": [
        {
          "name": "initiate representation -> order amount = quote (201)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
            "const d = pm.response.json().data;",
            "pm.test('order amountPaise = 750000 (the quote, not a fixed price)', function () { pm.expect(d.amountPaise).to.eql(750000); });",
            "pm.test('orderId present', function () { pm.expect(d.orderId).to.be.a('string'); });"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" }, "url": { "raw": "{{baseUrl}}/payments/{{repBookingId}}/initiate", "host": ["{{baseUrl}}"], "path": ["payments", "{{repBookingId}}", "initiate"] } }
        }
      ]
    },
    {
      "name": "6. Stats & list include representation",
      "item": [
        {
          "name": "stats byServiceType has representation key (200)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
            "const d = pm.response.json().data;",
            "pm.test('byServiceType.representation is a number', function () { pm.expect(d.byServiceType.representation).to.be.a('number'); });",
            "pm.test('representation count >= 1', function () { pm.expect(d.byServiceType.representation).to.be.at.least(1); });"
          ] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/admin/stats", "host": ["{{baseUrl}}"], "path": ["admin", "stats"] } }
        },
        {
          "name": "list filter serviceType=representation (200)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
            "const b = pm.response.json();",
            "pm.test('every item serviceType = representation', function () { b.data.forEach(function (it) { pm.expect(it.serviceType).to.eql('representation'); }); });",
            "pm.test('at least one representation booking', function () { pm.expect(b.data.length).to.be.at.least(1); });"
          ] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/admin/bookings?serviceType=representation&limit=100", "host": ["{{baseUrl}}"], "path": ["admin", "bookings"], "query": [{ "key": "serviceType", "value": "representation" }, { "key": "limit", "value": "100" }] } }
        }
      ]
    }
  ]
}
